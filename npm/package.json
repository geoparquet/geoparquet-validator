{
  "name": "geoparquet-validator",
  "version": "0.2.0",
  "description": "Validate GeoParquet files in the browser or Node: the OGC GeoParquet 2.0 abstract tests, and the 1.0/1.1 community rules",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "https://github.com/geoparquet/geoparquet-validator" },
  "homepage": "https://validator.geoparquet.org/",
  "keywords": ["geoparquet", "parquet", "geospatial", "validation", "ogc", "wasm"],
  "type": "module",
  "main": "./index.cjs",
  "module": "./index.js",
  "exports": {
    ".": { "node": { "import": "./index.js", "require": "./index.cjs" }, "default": "./bundler/geoparquet_validator.js" },
    "./bundler": "./bundler/geoparquet_validator.js",
    "./node": "./node/geoparquet_validator.js"
  },
  "files": ["index.js", "index.cjs", "bundler/", "node/", "README.md", "LICENSE"]
}
